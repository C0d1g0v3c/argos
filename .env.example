# Copiar a .env y llenar. .env está en .gitignore — nunca se commitea.

# --- Base de datos ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=argos
POSTGRES_USER=argos
POSTGRES_PASSWORD=cambiar-esto

# --- Plataforma objetivo del leaderboard ---
# 'bybit' | 'binance'
ARGOS_PLATFORM=bybit

# --- Rate limiting del scraper (segundos entre requests) ---
# Agresivo a propósito: un cohorte chico obtenido limpiamente vale más
# que uno grande obtenido de forma que te banean a la semana 3.
ARGOS_MIN_REQUEST_INTERVAL=3.0

# --- Intervalo del job de ingesta continua (segundos) ---
ARGOS_POLL_INTERVAL=300
